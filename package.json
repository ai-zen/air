{
  "name": "@ai-zen/air",
  "version": "0.3.3",
  "description": "Minimalist AI CLI assistant — one shell tool, filesystem memory, auto context migration",
  "type": "module",
  "main": "./dist/agent-runtime.js",
  "bin": {
    "air": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "node scripts/check-publish-tool.mjs && npm run build",
    "start": "npm run build && node ./dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "prebuild": "pnpm run clean"
  },
  "dependencies": {
    "@ai-zen/agents-core": "^2.4.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "inquirer": "^9.3.8"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.10",
    "@types/node": "^24.12.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "ai",
    "cli",
    "assistant",
    "shell",
    "deepseek",
    "terminal",
    "command-line"
  ]
}
